bindsym $mod+a focus parent

# Move between workspaces ON A TOUCHPAD!!!!

bindgesture swipe:4:left  workspace prev
bindgesture swipe:4:right workspace next

#
# Multimedia keys
#

# Pulse Audio controls
# Volume (clamped to 100% via helper script)
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/vol.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/vol.sh down
bindsym XF86AudioMute        exec --no-startup-id ~/.local/bin/vol.sh mute
# Microphone mute toggle (uses @DEFAULT_SOURCE@ and notifies)
bindsym XF86AudioMicMute     exec --no-startup-id ~/.local/bin/toggle-mic.sh


# Media player controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous


# Backlight / Brightness Control
bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# ===================== TOGGLE TOP MONITOR ========================
bindsym $mod+Shift+o exec swaymsg output $top toggle
