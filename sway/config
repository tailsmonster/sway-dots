# ===================== BASIC START-UP STUFF ======================

# Set the default font used by sway, I like firacode (from dwm config lol).
font pango:Firacode Bold 12

# Start the auth agent, if you don't use this you can comment out this line.
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id sh -c ' eval $(gnome-keyring-daemon --login) eval $(gnome-keyring-daemon --start --components=secrets,ssh) export SSH_AUTH_SOCK'

exec_always systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec_always dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

# --- Notifications daemon (SwayNotificationCenter)
exec_always --no-startup-id swaync --daemon

# --- Make sure portals/apps see the Wayland env
exec_always --no-startup-id systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exec_always --no-startup-id dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE=wayland

# --- LANGUAGES ----
exec_always fcitx5 -d




# Start the network manager applet, can comment out this line if you don't use network manager.
exec nm-applet

# =================================================================



# ===================== MONITORS ==================================
# enter `swaymsg -t get_outputs` to get your monitor details.


# adaptive sync baybee
 output * adaptive_sync on

#========= DESKTOP ===================

# These are simply my details, they **wont** work for you, I've
# included them to serve as an example.
#  output HDMI-A-2 pos 4480 0 res 3840x2160@59.997Hz
#  output DP-3 pos 0 0 res 3440x1440@120.000Hz
#  output HDMI-A-1 pos 0 -1440 res 3440x1440@99.982Hz


#========= THINKPAD P14s ===================
# output eDP-1 pos 0 0 res 1920x1200@60Hz
output DP-2 pos 0 0 res 3440x1440@59.973Hz 
output eDP-1 pos 760 1440 res 1920x1200@60Hz 

# =================================================================

# ===================== OUTPUT NAMES ==============================
# Rename outputs so rules stay readable
# DESKTOP:
# set $main DP-3
# set $top  HDMI-A-1

# THINKPAD:
set $main eDP-1
set $top  DP-2


# ================================================================


#!!!!!!!!!!!!!!!!!!!!!! EDIT THIS !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# ===================== WALLPAPER =================================
# You can have different wp per monitor by changing the *
# to the specific display output. Make sure to edit the directory
# to your wallpaper!

output * bg "/home/tailsmonster/Pictures/Wallpapers/wallpaper.png" fill
output * bg "/home/tailsmonster/Pictures/Wallpapers/wallpaper2.png" fill
output * bg "/home/tailsmonster/Pictures/Wallpapers/wallpaper3.png" fill
output * bg "/home/tailsmonster/Pictures/Wallpapers/wallpaper4.png" fill
output * bg "/home/tailsmonster/Pictures/Wallpapers/wallpaper5.jpeg" fill

# =================================================================



# ===================== APP VARIABLES =============================
# These are the applications we use, and also where I set the 
# mod key (in this case it's the super key, i.e the windows key.)
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $application_launcher pgrep wofi >/dev/null 2>&1 && killall wofi || wofi --show drun

# --- THE FILE EXPLORER! I recommend either nautilus or nemo, personally I think nautilus fits nicely,
# --- although make sure to install and use my GTK theme, guide on that is in the github README.
set $file_explorer GTK_THEME=diinki-retro-dark nemo
# =================================================================



# ====== BORDERS & GAPS & CORNERS & SHADOWS & TRANSPARENCY ============

# Gaps between windows
gaps inner 8px
gaps outer 4px

# Border width, I prefer THIN borders ^-^
default_border pixel 1px
default_floating_border pixel 1px

# Corner radius!!
corner_radius 15
layer_effects waybar corner_radius 0




# The border colors:

#                         border    bg        text      ind       child border
client.focused          #d8cab8 #141216 #d8cab8 #d8cab8 #d8cab8
client.focused_inactive #AC82E9 #141216 #d8cab8 #AC82E9 #AC82E9
client.unfocused        #AC82E9 #141216 #d8cab8 #AC82E9 #AC82E9
client.urgent           #fcb167 #141216 #d8cab8 #fcb167 #fcb167
client.placeholder      #AC82E9 #141216 #d8cab8 #AC82E9 #AC82E9


# I am shadow the hedgehog, i'm the worlds ultimate lifeform 
shadows enable

# Tasteful defaults (tweak to taste)
shadow_blur_radius 22
shadow_color #00000066            # 40% black
shadow_inactive_color #00000033   # lighter when unfocused
shadow_offset 0 10                 # y-only drop


# Default opacity for all windows
# for_window [app_id=".*"] opacity 0.95

# Make terminal handle it's own transparency
for_window [app_id="Alacritty"] opacity 1.00

# for_window [app_id="chromium"]    opacity 0.9
for_window [app_id="codium"]    opacity 0.95
for_window [app_id="chat-gpt"]   opacity 0.95
for_window [class="discord"]    opacity 0.95
for_window [app_id="Slack"]      opacity 0.95

# Handy keybinds to adjust the focused window on the fly
bindsym $mod+minus   opacity minus 0.05
bindsym $mod+equal opacity plus 0.05
bindsym $mod+Backspace opacity set 1


# =================================================================


# ===================== INPUT & KEYBOARD ==========================

# I've included an example for dual keyboard layouts here, english and swedish,
# as it's what I use. You can add/remove languages, change from "us,se" to "us,es"
# for instance, if you want spanish; or any other.
# You toggle between the languages with ALT+SHIFT
input * {
  xkb_layout "jp,us"
  xkb_options "grp:alt_shift_toggle"
}

# =================================================================



# ===================== THE INFO/TASKBAR ==========================
# Simple, this just starts waybar which is what we are using.
bar {
  swaybar_command waybar
}
# =================================================================



# ===================== SCREENSHOTS ===============================

bindsym Print         exec --no-startup-id ~/.local/bin/screenshots_sway.sh #monitor
bindsym Shift+Print   exec --no-startup-id ~/.local/bin/screenshots_sway.sh window
bindsym Control+Print exec --no-startup-id ~/.local/bin/screenshots_sway.sh cursor


# ===================== BASIC KEYBINDS ============================
# These are the most basic keybinds which are very commonly used, 
# feel free to change them, the usage/syntax should be easy to
# understand and edit.


bindsym $mod+Return exec $term
bindsym $mod+e exec $file_explorer
bindsym $mod+p exec $application_launcher
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+space floating toggle

floating_modifier $mod normal

# Exit sway command, I add a pop-up so you can't do this on accident, thank me later.
bindsym $mod+Shift+e exec swaynag -t warning -m "Are you sure you want to exit sway?" -B "Yes, EXIT!" "swaymsg exit" --font="CaskaydiaCove Nerd Font bold 12"
# ================================================================



